# Optional cloud AI (never commit real keys). Used only by services/api.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# Optional sync database (self-host / cloud). Local-first mode does not need these.
DATABASE_URL=
BLOB_STORE_URL=

# Optional Auth0. Authentication is not required for core reading.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
