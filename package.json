{
  "name": "locked-in-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source, local-first reading OS. Read faster. Listen anywhere. Remember everything. Own your knowledge.",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev --filter=@locked-in/web --filter=@locked-in/extension",
    "dev:web": "pnpm --filter @locked-in/web dev",
    "dev:extension": "pnpm --filter @locked-in/extension dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
